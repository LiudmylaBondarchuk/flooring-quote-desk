#!/bin/sh
# Warns rather than blocks: the build refuses a secret in any case, and a clone should not be
# unable to commit at all because one tool is not installed on this kind of machine.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --config .gitleaks.toml || exit 1
else
  echo "pre-commit: gitleaks is not installed here, so nothing scanned this commit locally."
  echo "            the build still refuses a secret. install it to catch one earlier."
fi
