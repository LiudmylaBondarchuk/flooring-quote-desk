#!/bin/sh
# git names the refs being pushed on stdin: "<local ref> <local sha> <remote ref> <remote sha>".
# A deletion arrives with no local ref and an all-zero sha. Judging the shape of whatever branch
# happens to be checked out while deleting a different one measures the wrong thing entirely, and
# forces --no-verify on an ordinary tidy-up, which is how a guard teaches people to switch it off.
pushing=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    ''|0000000000000000000000000000000000000000) continue ;;
    *) pushing=1 ;;
  esac
done
[ "$pushing" = "1" ] || exit 0

branch=$(git rev-parse --abbrev-ref HEAD)
case "$branch" in main|master) exit 0 ;; esac

# The rules live in scripts/guards.mjs, which the build runs against the same commits.
base=origin/main
git rev-parse --verify --quiet "$base" >/dev/null || base=main
exec node scripts/guards.mjs "$base"
