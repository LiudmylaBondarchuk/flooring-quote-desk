# n8n instance that runs the workflows
N8N_BASE_URL=https://n8n.example.com
N8N_API_KEY=

# Postgres used by the bot — not n8n's own database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# the disposable database from compose.yaml — db:check and db:round-trip write to it and wipe it
CHECK_DATABASE_URL=postgres://postgres:local@localhost:5433/postgres
