# n8n instance that runs the workflows
N8N_BASE_URL=https://n8n.example.com
N8N_API_KEY=

# Postgres used by the bot — not n8n's own database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# an empty, throwaway database — db:check and db:round-trip write to it and drop it again
CHECK_DATABASE_URL=postgresql://user:password@host/throwaway?sslmode=require
